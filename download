
import { destinations } from "@/data/destinations";
export const revalidate = 3600;
export async function getWeatherMap(){
 const result:any={}
 await Promise.all(destinations.map(async(d)=>{
 const url=`https://api.open-meteo.com/v1/forecast?latitude=${d.latitude}&longitude=${d.longitude}&current=temperature_2m,relative_humidity_2m,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max&forecast_days=7`;
 const r=await fetch(url,{next:{revalidate:3600}});
 const j=await r.json();
 result[d.id]=j;
 }));
 return result;
}
